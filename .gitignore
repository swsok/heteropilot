# Ignore env file
env/

# Ignore python cache
*.pyc
__pycache__/
*.joblib

# Ignore pkl files
*.pkl

# Ignore bench results
bench/results/

# AI agent cache files
.claude/
.codex/
.cursor/
.copilot/
.aider*
.continue/

# HeteroPilot scratch and regenerable outputs.
# Planner work dirs, envelope caches and re-runnable simulation artifacts are
# untracked: simulations are deterministic given the committed code, profiles
# and seeds. Measured (irreplaceable) artifacts and validation summaries are
# committed explicitly with `git add -f`.
outputs/.hp-*
outputs/phase0_bench/
# Per-bandwidth cluster configs written by pd_sim_network_sweep.py. They must
# live under the repo tree (the simulator prepends "../" to a relative
# --cluster-config and cannot open an absolute path), so they cannot go to /tmp;
# each is a copy of a committed config with link_bw overridden.
outputs/.pd_sim_sweep/

# STEP V2/V3 of WORK_ORDER_p2_regular_spec_evidence.md. Simulator work dirs and
# the open-loop driver's raw client records. The re-simulation that matters is
# its CONCLUSION, which is committed in experiments/p2_evidence/results/, and
# the runs themselves are deterministic from the committed trace seed. V2's
# MEASURED client records are the exception and are added with `git add -f`,
# because a measurement is not re-runnable.
outputs/p2_evidence/

# RNGD profiling intermediates. The measured bundle itself lives in
# profiler/perf/RNGD/, and outputs/rngd_profile/ keeps only what stays
# auditable: the compute/DMA breakdown behind every union-based time_us, the
# per-run summaries, and device_facts.json. Per-shard logs and chrome traces are
# bulky and regenerable (experiments/scripts/run_rngd_profile.py).
outputs/rngd_profile/shards/
outputs/rngd_profile/retry_*/
outputs/rngd_profile/traces/

# EDF profiler traces from FuriosaAI's own profiler. 155 MB across six
# concurrency passes, and fully regenerable by
# `rebuild_rngd_bundle_from_edf.py collect` (which re-serves the artifact), so
# the raw CSVs stay out. What IS committed is everything derived from them: the
# §3.7 bundle under profiler/perf/RNGD-CARD/, the per-request client timings,
# and the audit files (edf_vs_harness_dense.csv, edf_decode_attention.csv,
# edf_composed.json) that show how each bundle number was obtained.
outputs/rngd_edf_bundle/edf/edf_c*.csv
outputs/rngd_edf_bundle/edf/serve_c*.log
outputs/rngd_edf_bundle/*_sparse.jsonl
outputs/rngd_vendor_prof/edf.json

# oh-my-claudecode session state.
.omc/

# RNGD staging and diagnostic leftovers. The authoritative bundles live in
# profiler/perf/RNGD/ and profiler/perf/RNGD-CARD/; outputs/rngd_profile/tp*/ are
# the pre-import staging copies of the same CSVs, and the probe logs exist so a
# failed collective-probe worker is diagnosable (they are regenerable per run).
outputs/rngd_profile/tp[0-9]*/
outputs/rngd_profile/collective_probe_logs/
outputs/rngd_card_profile/
# Smoke-test and verification scratch from environment bring-up.
outputs/envcheck/smoke.csv
outputs/envcheck/plan.yaml
outputs/envcheck/rngd_verify.csv
outputs/rngd_edf_bundle/sim_sparse*.csv

# Vendor-specific venvs (one per NPU vendor; see docs/hardware_roadmap.md)
.venv-rbln/
.venv-furiosa/
.venv-rbln-vllm/

# Envelope EDF stage traces: 166 MB, reproducible from the command in
# experiments/results/rngd_concurrency_envelope.md, and no claim there uses them
# (they exist for bundle rebuilding, not for the throughput/latency envelope).
outputs/rngd_envelope/edf/*.csv

# Synthetic Tier 0/1 perf bundles are regenerated by
# scripts/gen-tier0-bundles.sh, never committed (tiered-profiles STEP 10:
# measured and synthetic data must not mix in the tree - rules A1/A3).
profiler/perf/*-t0/
profiler/perf/*-t1/
outputs/e1-*/

# STEP 1 simulation-cost profiling (WORK_ORDER_rps_aware.md). The pyinstrument
# sessions are 180-470 MB each and the CSVs 2 MB; outputs/perf/SHA256SUMS and the
# rendered .txt reports carry everything docs/sim_cost_profile.md cites.
outputs/perf/*.pyisession
outputs/perf/*.html
outputs/perf/*.json
outputs/perf/*.csv
outputs/perf/*.jsonl
# The top-k EnvelopeCache corpora ARE the evidence -- 180 vs 12 entries is what
# makes "8.1x faster because it simulated 12 of 180" checkable, and they replay
# through `exp_surrogate.py --cache-dir` (D30). The patterns above are one level
# deep and so do not reach them; say so, rather than leave it to glob depth.
!outputs/perf/topk/cache_full/*.json
!outputs/perf/topk/cache_topk20/*.json

# exp_surrogate replay runs regenerate from the corpora they name; keep the
# summaries, not the per-run workload traces.
outputs/exp_surrogate/**/workload.jsonl
outputs/exp_surrogate/**/sims/

# slab3d calibration: the per-run CSVs and logs regenerate from the committed
# configs in seconds; runs.json and fits.json carry every number the table cites.
outputs/slab3d_calib/*.csv
outputs/slab3d_calib/*.log

# STEP 2.3 end-to-end check: 612 simulation work dirs regenerate from the command
# in the plan's provenance; the plan and its log are the record.
outputs/asym_plan/work/

# E6a: two fixtures x 4 rates of 300-request simulations. The per-run work dirs
# and caches regenerate from the committed command; the sweep JSON, the knob
# policies and the result document are the record.
outputs/e6/*/work/
outputs/e6/*/cache/
outputs/e6/probe/

# A40 low-load campaign, 2026-09-10/11 (docs/HANDOVER.md §2.2). Same split as
# outputs/e6/ and outputs/lowload_sim_error/ above: what was MEASURED is
# committed, what a committed input plus a seed regenerates is not.
#
# The E6 re-run's work and cache dirs are 1.6 GB of deterministic simulation --
# the same exclusion outputs/.hp-* gets. Only the sweep summaries are kept.
outputs/e6_rerun/*/work/
outputs/e6_rerun/*/cache/
# Re-spaced arrival traces: `respace_trace`/`write_trace` regenerate them
# byte-for-byte from the committed dataset and the rate recorded in the point.
outputs/a40_envelope_openloop/trace_*.jsonl
outputs/a40_lowload_sim_error/trace_*.jsonl
# The smoke run that validated the harness. Its meta.json and requests.jsonl are
# kept as outputs/a40_envelope_openloop/lowload_reference/ because a test reads
# them; the rest of the directory is scratch.
outputs/a40_envelope_openloop/_smoke/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
